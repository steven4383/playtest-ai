# PlayTest AI — backend configuration (copy to .env)
APP_ENV=local
HOST=127.0.0.1
PORT=8000

# Storage
DATABASE_PATH=./playtest_ai.db
STORAGE_DIR=./storage
MAX_APK_SIZE_MB=300

# Android SDK (leave empty to auto-detect ANDROID_HOME / %LOCALAPPDATA%\Android\Sdk)
ANDROID_SDK_ROOT=
# Folder for AVD data, e.g. M:\Android\avd (empty = %USERPROFILE%\.android\avd). Also settable on Device Manager → Storage
AVD_STORAGE_DIR=
# Folder for system images, e.g. M:\Android\system-images (empty = inside the SDK). Each image is moved there and
# linked back with a junction; new downloads are moved after sdkmanager finishes. Settable on Device Manager -> Storage
SYSTEM_IMAGES_DIR=
# Flutter SDK folder and scrcpy.exe (both auto-detected from PATH when empty)
FLUTTER_ROOT=
SCRCPY_PATH=
# Java for sdkmanager/avdmanager (leave empty to use JAVA_HOME or Android Studio's bundled JBR)
JAVA_HOME=

# Emulator execution limits (8 GB laptop => keep 1)
MAX_CONCURRENT_EMULATORS=1
EMULATOR_RAM_MB=2048
EMULATOR_GPU_MODE=host
EMULATOR_HEADLESS=true
# Start from a clean saved snapshot (seconds instead of a 1-2 min cold boot); the first start of each AVD saves it
EMULATOR_FAST_BOOT=true
# CPU cores per emulator (0 = auto: half the host threads, 2-4)
EMULATOR_CORES=0
DEVICE_BOOT_TIMEOUT_SECONDS=180

# Capacity planning (GB kept free for Windows + Node + browser)
HOST_RESERVED_RAM_GB=4.5

# Appium
APPIUM_SERVER_URL=http://127.0.0.1:4723
DEFAULT_UIAUTOMATOR2_SYSTEM_PORT=8200

# LLM (used from Phase 6). Provider: gemini
LLM_PROVIDER=gemini
# Free key: https://aistudio.google.com/apikey  (or paste it on the dashboard's "AI (Gemini)" page)
GEMINI_API_KEY=
# Free-tier Flash model; the AI page lists the models your key can use
GEMINI_MODEL=gemini-3.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=

# Metrics
METRICS_INTERVAL_MS=2000
